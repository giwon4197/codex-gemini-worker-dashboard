{
  "name": "coxgem",
  "displayName": "coXgem",
  "description": "Local AI conversation and background worker orchestration inside VS Code. Works with the Codex and Gemini CLIs; not affiliated with OpenAI or Google.",
  "version": "0.1.0",
  "publisher": "coxgem",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/onseoh/codex-gemini-worker-dashboard.git",
    "directory": "vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/onseoh/codex-gemini-worker-dashboard/issues"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "coxgem",
          "title": "coXgem",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "coxgem": [
        {
          "type": "webview",
          "id": "coxgem.conversation",
          "name": "Conversation"
        }
      ]
    },
    "commands": [
      {
        "command": "coxgem.openWorkspace",
        "title": "Open Workspace",
        "category": "coXgem"
      },
      {
        "command": "coxgem.explainSelection",
        "title": "Explain Selection",
        "category": "coXgem"
      },
      {
        "command": "coxgem.planFixForSelection",
        "title": "Plan Fix for Selection",
        "category": "coXgem"
      },
      {
        "command": "coxgem.showActiveRun",
        "title": "Show Active Run",
        "category": "coXgem"
      },
      {
        "command": "coxgem.reviewChanges",
        "title": "Review Changes",
        "category": "coXgem"
      },
      {
        "command": "coxgem.refreshUsage",
        "title": "Refresh Usage",
        "category": "coXgem"
      },
      {
        "command": "coxgem.refreshTaskTree",
        "title": "Refresh Task Tree",
        "category": "coXgem",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "coxgem.explainSelection",
          "when": "editorHasSelection",
          "group": "coxgem@1"
        },
        {
          "command": "coxgem.planFixForSelection",
          "when": "editorHasSelection",
          "group": "coxgem@2"
        }
      ],
      "view/title": [
        {
          "command": "coxgem.refreshTaskTree",
          "when": "view == coxgem.conversation",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "coXgem",
      "properties": {
        "coxgem.codexModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "계획·대화 단계에서 `codex exec --model` 에 전달할 모델 id. 비워두면 `model-tiers.json` 의 `codex_default_model` 을 씁니다."
        },
        "coxgem.codexChatModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "워커를 만들지 않는 설명 전용 요청(Explain Selection)에 쓸 모델 id. 비워두면 `coxgem.codexModel` 을 따릅니다."
        },
        "coxgem.workerTier": {
          "type": "string",
          "enum": ["fast", "normal", "advanced", "reasoning"],
          "default": "normal",
          "markdownDescription": "Gemini 워커 모델 등급. 작업 폴더의 `worker-settings.json` 에 저장되어 웹 대시보드와 공유됩니다."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "typecheck": "tsc --noEmit -p .",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies",
    "test": "node --experimental-strip-types --test src/workspace-context.test.ts src/core-host.test.ts src/ids.test.ts src/graph-tree.test.ts src/restore-state.test.ts src/protocol.test.ts src/webview-script.test.ts"
  },
  "vsce": {
    "dependencies": false
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/vscode": "^1.106.0",
    "@vscode/vsce": "3.7.1",
    "esbuild": "0.25.11",
    "typescript": "5.9.3"
  }
}
