      "tier": "fast",
      "read_scope": {
        "root": "task_worktree",
        "mode": "project_wide_search",
        "deny": [
          ".env*",
          "**/secrets/**",
          "**/credentials/**",
          ".git/**"
        ]
      },
      "write_scope": {
        "expected": [
          "docs/worker-b.md"
        ],
        "derived_auto_expand": false,
        "sensitive": [
          "tests/**",
          "package.json"
        ],
        "forbidden": [
          ".env*",
          "**/secrets/**",
          ".git/**",
          ".agent/**"
        ]
      },
      "merge_scope": [
        "docs/worker-b.md"
      ],
      "forbidden_operations": [
        "git push",
        "force push"
      ],
      "expected_change_scope": {
