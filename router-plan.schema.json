{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical v2.1 planner output",
  "description": "Internal executable planner output requires allowed_files plus read_scope, write_scope and merge_scope. allowed_files mirrors write_scope.expected. Legacy allowed_files-only task files are supported by runtime normalization outside this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["level", "parallelizable", "max_workers", "summary", "integration_test_commands", "tasks"],
  "properties": {
    "level": { "type": "integer", "minimum": 0, "maximum": 3 },
    "parallelizable": { "type": "boolean" },
    "max_workers": { "type": "integer", "minimum": 1, "maximum": 2 },
    "summary": { "type": "string", "minLength": 1 },
    "integration_test_commands": { "type": "array", "items": { "type": "string", "minLength": 1 }, "maxItems": 8 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "objective", "prompt", "depends_on", "allowed_files", "read_scope", "write_scope", "merge_scope", "acceptance_criteria", "test_commands", "forbidden_operations", "expected_change_scope", "tier", "timeout_seconds", "retry_limit"],
        "properties": {
          "id": { "type": "string", "pattern": "^TASK-[0-9]{3}$" },
          "name": { "type": "string", "minLength": 1 },
          "objective": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^TASK-[0-9]{3}$" } },
          "allowed_files": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
          "read_scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["root", "mode", "deny"],
            "properties": {
              "root": { "type": "string", "enum": ["task_worktree"] },
              "mode": { "type": "string", "enum": ["project_wide_search"] },
              "deny": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          },
          "write_scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expected", "derived_auto_expand", "derived_approved", "sensitive", "forbidden"],
            "properties": {
              "expected": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
              "derived_auto_expand": { "type": "boolean" },
              "derived_approved": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "sensitive": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "forbidden": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          },
          "merge_scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expected", "patterns", "deny"],
            "properties": {
              "expected": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
              "patterns": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "deny": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          },
          "acceptance_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "test_commands": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "maxItems": 8 },
          "forbidden_operations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "expected_change_scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["files", "lines"],
            "properties": {
              "files": { "type": "integer", "minimum": 0 },
              "lines": { "type": "integer", "minimum": 0 }
            }
          },
          "tier": { "type": "string", "enum": ["fast", "normal", "advanced", "reasoning"] },
          "timeout_seconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
          "retry_limit": { "type": "integer", "minimum": 0, "maximum": 3 }
        }
      }
    }
  }
}
